{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SM Sourcing",
  "version": "0.1.10",
  "identifier": "com.smsourcing.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SM Sourcing ERP",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduaW5nIHB1YmxpYyBrZXk6IDdDMUUzQkVDN0E3MDVCMkQKUldRdFczQjY3RHNlZkhNOFVzeCtWVGY4dWVqUG96am04VjNDaFhSZU4zeUg1eHpsY1BHcCtjTmEK",
      "endpoints": [
        "https://github.com/riadsarkar45/sms-desktop-version/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
